SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=production
DATABASE_URL=sqlite:////app/data/festival.db
UPLOAD_FOLDER=/app/uploads
MAX_CONTENT_LENGTH=16777216
# Optional: store gallery and profile photos in Google Cloud Storage
GCS_BUCKET_NAME=
# Set true for fastest image loading (public read URLs). false = private bucket + signed URLs.
GCS_PUBLIC_READ=true
GCS_SIGNED_URL_HOURS=24
GCS_CACHE_CONTROL=public, max-age=86400
# Comma-separated usernames who can access /site-admin (optional; defaults to all committee admins)
SITE_ADMIN_USERNAMES=
